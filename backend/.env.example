# Database Connection (Neon, Vercel Postgres, Supabase, or local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rauhie_shop?schema=public"

# Vercel Postgres environment variables (automatically set by Vercel when linked)
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."

# JWT Authentication Secret
JWT_SECRET="rauhie_shop_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=4000

# Client origin (for CORS)
CORS_ORIGIN="http://localhost:3000"

